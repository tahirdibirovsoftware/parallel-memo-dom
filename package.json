{
  "name": "parallel-memo-dom",
  "version": "1.1.2",
  "description": "A browser library for offloading heavy computations to web workers with memoization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "prepare": "husky install"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "eslint": "^8.36.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.8",
    "vitest": "^0.34.2",
    "@types/node": "^20.8.0",
    "jsdom": "^22.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.0",
    "@commitlint/config-conventional": "^17.6.0",
    "@commitlint/cli": "^17.6.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.1"
  },
  "keywords": [
    "browser",
    "web workers",
    "parallel",
    "computation",
    "memoization",
    "dom"
  ],
  "author": "Tahir Dibirov",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tahirdibirovsoftware/parallel-memo-dom"
  },
  "bugs": {
    "url": "https://github.com/tahirdibirovsoftware/parallel-memo-dom/issues"
  },
  "homepage": "https://github.com/tahirdibirovsoftware/parallel-memo-dom#readme"
}
